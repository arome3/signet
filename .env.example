# Signet on Concordium testnet. Copy to .env and fill in.
SIGNET_NETWORK=testnet
# PLT used for payments. USDR is the x402 default; on testnet request your own via the PLT
# issuance form (docs.concordium.com/en/mainnet/tutorials/plt/request-plt.html) if you hold none.
# Native CCD also works (SIGNET_ASSET=CCD, 6 decimals, sponsored like a PLT payment): useful before a stablecoin arrives.
SIGNET_ASSET=USDR

# Buyer agent ("Kit"): Browser Wallet export of the agent's account, and its CIS-8004 badge
AGENT_WALLET_FILE=./keys/agent.export
AGENT_BADGE=
# Owner signs the mandate once: `npm run mandate:sign` reads MANDATE_FILE + OWNER_WALLET_FILE and writes
# SIGNED_MANDATE_FILE. Publish the printed hash as the badge's `signet.mandate` metadata; merchants refuse
# agents whose mandate is unsigned or unpublished.
MANDATE_FILE=./mandate.example.json
SIGNED_MANDATE_FILE=./out/mandate.signed.json
# Owner's Browser Wallet export. Used by mandate:sign; if set for demo:live, a "y" at the terminal
# becomes an owner-signed approval merchants can verify (until ID App approval transport exists).
OWNER_WALLET_FILE=./keys/owner.export
# Optional: an account that sponsors the agent's anchor transactions (so the agent needs no CCD)
ANCHOR_SPONSOR_WALLET_FILE=

# Merchant agent ("FreshMart"): business identity (Global FinReg test IdP), its badge
MERCHANT_WALLET_FILE=./keys/merchant.export
MERCHANT_BADGE=
MERCHANT_NAME=FreshMart
MERCHANT_DOMAIN=freshmart.example
MERCHANT_PORT=4021
# Paid orders, used payment signatures and spend per agent survive restarts here (written atomically).
MERCHANT_STATE_FILE=./out/merchant-state.json
# Merchant must prove its domain: DNS TXT at _signet.<MERCHANT_DOMAIN> = "signet-account=<merchant account>".
# Public base URL of the merchant (https on MERCHANT_DOMAIN); it goes into the signed directory listing.
MERCHANT_URL=
# Directory: `npm run directory:build` has the merchant sign its listing and the operator sign the list.
# Buyers only pay merchants in this file, at its listed prices, and trust only DIRECTORY_OPERATOR's signature.
DIRECTORY_FILE=./out/directory.json
DIRECTORY_OPERATOR_WALLET_FILE=
DIRECTORY_OPERATOR=
# Brands and domains must be plain ASCII in one script; list exact exceptions here (comma-separated).
DIRECTORY_ALLOW_BRANDS=
DIRECTORY_ALLOW_DOMAINS=
# Local runs only: accept http://127.0.0.1 endpoints in listings. Never set in a deployed setup.
SIGNET_ALLOW_LOOPBACK_ENDPOINTS=
# Facilitator that sponsors buyers' payment fees (defaults to the merchant account)
FACILITATOR_WALLET_FILE=

# Identity-provider classification. Leave empty to auto-detect by IdP name via gRPC.
AGENT_IDP_INDICES=
BUSINESS_IDP_INDICES=
# IdPs accepted as issuers for age proofs
AGE_PROOF_IDPS=0,1,2,3

# Optional overrides
# CCD_GRPC_HOST=grpc.testnet.concordium.com
# CCD_GRPC_PORT=20000
# AGENT_REGISTRY_MCP_URL=https://agent-registry-mcp.concordium.com/mcp
